--- m0-echo/src/ChatClient.java	1970-01-01 00:00:00.000000000 +0000
+++ m1-framing/src/ChatClient.java	2026-10-09 17:41:55.962552811 +0000
@@ -0,0 +1,117 @@
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * M1 chat client.
+ *
+ * Two threads:
+ *   - main thread:     reads the keyboard and SENDS (only this thread writes);
+ *   - receiver thread: READS the socket and prints what arrives.
+ * A single thread could not do both, because reading the keyboard blocks
+ * and messages from the server must appear while you are typing.
+ *
+ * Usage: java -cp out ChatClient [--host 127.0.0.1] [--port 12345] [--nick ana]
+ */
+public class ChatClient {
+
+    /** True between sending NICK and receiving its answer. */
+    private static volatile boolean waitingForNickReply = false;
+    /** Set when WE close the socket, so the receiver does not report an error. */
+    private static volatile boolean quitting = false;
+
+    public static void main(String[] args) throws IOException {
+        Cli cli = new Cli(args);
+        String host = cli.get("host", "127.0.0.1");
+        int port = cli.getInt("port", 12345);
+        BufferedReader keyboard = new BufferedReader(new InputStreamReader(System.in, StandardCharsets.UTF_8));
+
+        String nick = cli.get("nick", null);
+        while (nick == null || nick.isBlank()) {
+            System.out.print("Nickname: ");
+            nick = keyboard.readLine();
+            if (nick == null) return;
+        }
+
+        Socket socket = new Socket(host, port);
+        System.out.println("Connected to " + socket.getRemoteSocketAddress()
+                + ". Type a message and press Enter. /nick <name>, /quit");
+        OutputStream out = socket.getOutputStream();
+
+        Thread receiver = new Thread(() -> receiveLoop(socket), "receiver");
+        receiver.setDaemon(true);
+        receiver.start();
+
+        send(out, Protocol.nick(nick.strip()));
+        waitingForNickReply = true;
+
+        String line;
+        while ((line = keyboard.readLine()) != null) {
+            if (line.isBlank()) continue;
+            if (line.equals("/quit")) break;
+            if (line.startsWith("/nick ")) {
+                send(out, Protocol.nick(line.substring(6).strip()));
+                waitingForNickReply = true;
+            } else {
+                send(out, Protocol.msg(line));
+            }
+        }
+        quitting = true;
+        socket.close();
+    }
+
+    private static void send(OutputStream out, String json) throws IOException {
+        out.write((json + "\n").getBytes(StandardCharsets.UTF_8));
+        out.flush();
+    }
+
+    /** Receiver thread: bytes -> lines (LineFramer) -> JSON -> screen. */
+    private static void receiveLoop(Socket socket) {
+        LineFramer framer = new LineFramer();
+        byte[] chunk = new byte[4096];
+        try {
+            InputStream in = socket.getInputStream();
+            int n;
+            while ((n = in.read(chunk)) != -1) {
+                for (String line : framer.feed(chunk, n)) {
+                    display(line);
+                }
+            }
+            System.out.println("*** server closed the connection");
+        } catch (IOException e) {
+            if (!quitting) System.out.println("*** connection lost: " + e.getMessage());
+        }
+        System.exit(0);   // the main thread is stuck reading the keyboard; end the program
+    }
+
+    /** Prints one server message. Unknown messages are shown raw, never dropped. */
+    private static void display(String line) {
+        Map<String, Object> msg;
+        try {
+            msg = Json.parseObject(line);
+        } catch (Json.JsonException e) {
+            System.out.println("<<< (not JSON) " + line);
+            return;
+        }
+        String type = String.valueOf(msg.get("type")).toUpperCase(Locale.ROOT);
+        switch (type) {
+            case "CHAT":
+                System.out.println("[" + msg.get("from") + "] " + msg.get("text"));
+                break;
+            case "OK":
+                if (waitingForNickReply) {
+                    waitingForNickReply = false;
+                    System.out.println("*** nickname accepted");
+                }
+                break;   // other OKs only confirm a MSG; the CHAT echo already shows it
+            default:
+                System.out.println("<<< " + line);
+        }
+    }
+}
diff -ruN -x README.md -x CHANGES.diff -x out m0-echo/src/ChatServer.java m1-framing/src/ChatServer.java
--- m0-echo/src/ChatServer.java	1970-01-01 00:00:00.000000000 +0000
+++ m1-framing/src/ChatServer.java	2026-10-09 17:40:49.490706834 +0000
@@ -0,0 +1,107 @@
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.time.LocalTime;
+import java.time.format.DateTimeFormatter;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * M1 - Framing and a protocol.
+ *
+ * Still ONE client at a time (concurrency is M2). What is new compared to M0:
+ *   - bytes are cut into newline-delimited JSON messages by LineFramer;
+ *   - the server understands NICK and MSG;
+ *   - MSG is answered with OK plus a CHAT, which (with a single client)
+ *     goes back to the sender. M2 will send that CHAT to everyone.
+ *
+ * Usage: java -cp out ChatServer [--port 12345]
+ */
+public class ChatServer {
+
+    public static void main(String[] args) throws IOException {
+        Cli cli = new Cli(args);
+        int port = cli.getInt("port", 12345);
+
+        try (ServerSocket server = new ServerSocket()) {
+            server.setReuseAddress(true);
+            server.bind(new InetSocketAddress(port));
+            log("listening on TCP port " + port + " (M1: one client at a time)");
+            while (true) {
+                try (Socket socket = server.accept()) {
+                    serve(socket);
+                } catch (IOException e) {
+                    log("connection error: " + e.getMessage());
+                }
+            }
+        }
+    }
+
+    private static void serve(Socket socket) throws IOException {
+        String who = socket.getRemoteSocketAddress().toString();
+        log(who + " connected");
+        InputStream in = socket.getInputStream();
+        OutputStream out = socket.getOutputStream();
+        LineFramer framer = new LineFramer();
+        String nick = null;                       // null until the client sends NICK
+
+        byte[] chunk = new byte[4096];
+        int n;
+        while ((n = in.read(chunk)) != -1) {
+            List<String> lines = framer.feed(chunk, n);
+            // This log line is the M1 demo: watch partial and merged messages happen.
+            log(who + " read " + n + " byte(s) -> " + lines.size() + " complete message(s), "
+                    + framer.pending() + " byte(s) waiting for the rest");
+
+            for (String line : lines) {
+                Map<String, Object> msg;
+                try {
+                    msg = Json.parseObject(line);
+                } catch (Json.JsonException e) {
+                    log("  ignored, not JSON: " + e.getMessage());   // M3 will answer with ERROR
+                    continue;
+                }
+                String type = Json.getString(msg, "type");
+                type = type == null ? "" : type.toUpperCase(Locale.ROOT);   // be liberal: "nick" == "NICK"
+
+                if (type.equals("NICK")) {
+                    String requested = Json.getString(msg, "nick");
+                    if (requested == null || requested.isBlank()) {
+                        log("  ignored NICK without a nick");
+                        continue;
+                    }
+                    nick = requested.strip();
+                    log("  NICK -> registered as '" + nick + "'");
+                    send(out, Protocol.ok());
+                } else if (type.equals("MSG")) {
+                    String text = Json.getString(msg, "text");
+                    if (nick == null || text == null) {
+                        log("  ignored MSG (no NICK yet, or no text)");
+                        continue;
+                    }
+                    log("  MSG from " + nick + ": " + text);
+                    send(out, Protocol.ok());
+                    send(out, Protocol.chat(nick, text, false));
+                } else {
+                    log("  ignored unknown message type '" + type + "'");
+                }
+            }
+        }
+        log(who + " disconnected");
+    }
+
+    /** One message = JSON + "\n", encoded as UTF-8 and written in a single call. */
+    private static void send(OutputStream out, String json) throws IOException {
+        out.write((json + "\n").getBytes(StandardCharsets.UTF_8));
+        out.flush();
+    }
+
+    private static void log(String text) {
+        System.out.println(LocalTime.now().format(DateTimeFormatter.ofPattern("HH:mm:ss.SSS")) + " " + text);
+    }
+}
